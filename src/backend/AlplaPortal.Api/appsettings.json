{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppEnvironment": {
    "Code": "PROD",
    "Name": "Produção",
    "ShowBanner": false
  },
  "AppConfig": {
    "FrontendBaseUrl": "https://portal.alpla.com",
    "ITNotificationEmail": "aovia1-it@alpla.com",
    "ProformaDeadlineAlerts": {
      "Enabled": true,
      "CheckIntervalHours": 24,
      "ThresholdDays": [3, 1, 0],
      "CheckTimeUtcHour": 7
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "AlplaPortal_Super_Secret_Key_2024_@Local_Auth_Dev_32Chars",
    "Issuer": "AlplaPortal",
    "Audience": "AlplaPortalUsers",
    "ExpiryMinutes": 1440
  },
  "DocumentExtraction": {
    "DefaultProvider": "OPENAI",
    "GlobalTimeoutSeconds": 30,
    "DebugRawPayloadLogging": false,
    "AiOcrPolicy": {
      "RequireHumanConfirmation": true,
      "AllowedModules": [ "CONTRACTS", "REQUESTS" ],
      "AllowedDocumentTypes": [ ".pdf", ".jpg", ".jpeg", ".png" ],
      "AllowedRoles": [],
      "BlockHighRiskDocuments": true
    },
    "Retention": {
      "DebugFileRetentionDays": 7,
      "RawJsonResultRetentionDays": 90,
      "AutoCleanupEnabled": false
    },
    "OpenAi": {
      "Enabled": true,
      "TimeoutSeconds": 60,
      "Model": "gpt-4-turbo",
      "DeploymentName": "",
      "Endpoint": ""
    },
    "AzureDocumentIntelligence": {
      "Enabled": false,
      "TimeoutSeconds": 60
    }
  },
  "Security": {
    "Upload": {
      "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".doc", ".docx", ".xls", ".xlsx" ],
      "MaxFileSizeBytes": 15728640,
      "BlockedExtensions": [ ".exe", ".bat", ".cmd", ".sh", ".msi", ".js", ".vbs" ]
    },
    "Authentication": {
      "MaxFailedAttempts": 5,
      "LockoutDurationMinutes": 15
    },
    "RateLimiting": {
      "PermitLimit": 10,
      "WindowMinutes": 1,
      "EnableForLocalhost": false
    }
  },
  "Integrations": {
    "Primavera": {
      "Enabled": false,
      "Server": "",
      "InstanceName": "",
      "AuthenticationMode": "SQL",
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 15,
      "Companies": {
        "ALPLAPLASTICO": {
          "DatabaseName": "",
          "Enabled": true
        },
        "ALPLASOPRO": {
          "DatabaseName": "",
          "Enabled": true
        }
      }
    },
    "Innux": {
      "Enabled": false,
      "Server": "",
      "DatabaseName": "",
      "AuthenticationMode": "SQL",
      "TimeoutSeconds": 15
    },
    "AlplaProd": {
      "Enabled": false,
      "AuthenticationMode": "SQL",
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 30,
      "Plants": {
        "VIANA1": {
          "Server": "",
          "DatabaseName": "",
          "Enabled": true,
          "PipelineModel": "STANDARD"
        },
        "VIANA2": {
          "Server": "",
          "DatabaseName": "",
          "Enabled": true,
          "PipelineModel": "STANDARD"
        },
        "VIANA3": {
          "Server": "",
          "DatabaseName": "",
          "Enabled": true,
          "PipelineModel": "INHOUSE"
        }
      }
    }
  }
}