{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppEnvironment": {
    "Code": "PROD",
    "Name": "Produção",
    "ShowBanner": false
  },
  "ClientVersionEnforcement": {
    "_comment": "Version-mismatch write enforcement. Modes: Disabled | Observe | EnforceMismatch | EnforceAll. Start in Observe on TEST/PROD; promote per docs.",
    "Mode": "Observe"
  },
  "PostPaymentCompletion": {
    "_comment": "Post-Payment Completion Workflow. Release 1 is foundation-only: Enabled MUST stay false in every environment. TEST activation is a separately approved Release 2 change; PROD activation is Release 5. EffectiveDateUtc is evaluated against Request.CreatedAtUtc and only decides when classification is enforced at creation - it never lets an open grouped request skip classification.",
    "Enabled": false,
    "EffectiveDateUtc": "9999-12-31T23:59:59Z"
  },
  "AppConfig": {
    "FrontendBaseUrl": "https://portal.alpla.com",
    "ITNotificationEmail": "aovia1-it@alpla.com",
    "AttachmentsStoragePath": "data/attachments",
    "SuppliersStoragePath": "data/attachments/suppliers",
    "ProformaDeadlineAlerts": {
      "Enabled": true,
      "CheckIntervalHours": 24,
      "ThresholdDays": [3, 1, 0],
      "CheckTimeUtcHour": 7
    },
    "UserOnboarding": {
      "PasswordSetupTokenExpirationHours": 24
    }
  },
  "ITEquipment": {
    "TemplatesPath": "data/templates/it-equipment",
    "BrandingPath": "data/templates/branding",
    "StoragePath": "data/attachments/it-equipment"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "AlplaPortal_Super_Secret_Key_2024_@Local_Auth_Dev_32Chars",
    "Issuer": "AlplaPortal",
    "Audience": "AlplaPortalUsers",
    "ExpiryMinutes": 1440
  },
  "DocumentExtraction": {
    "DefaultProvider": "OPENAI",
    "GlobalTimeoutSeconds": 30,
    "DebugRawPayloadLogging": false,
    "AiOcrPolicy": {
      "RequireHumanConfirmation": true,
      "AllowedModules": [ "CONTRACTS", "REQUESTS" ],
      "AllowedDocumentTypes": [ ".pdf", ".jpg", ".jpeg", ".png" ],
      "AllowedRoles": [],
      "BlockHighRiskDocuments": true
    },
    "Retention": {
      "DebugFileRetentionDays": 7,
      "RawJsonResultRetentionDays": 90,
      "AutoCleanupEnabled": false
    },
    "OpenAi": {
      "Enabled": true,
      "TimeoutSeconds": 60,
      "Model": "gpt-4-turbo",
      "DeploymentName": "",
      "Endpoint": ""
    },
    "AzureDocumentIntelligence": {
      "Enabled": false,
      "TimeoutSeconds": 60
    }
  },
  "Security": {
    "Upload": {
      "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".doc", ".docx", ".xls", ".xlsx" ],
      "MaxFileSizeBytes": 15728640,
      "BlockedExtensions": [ ".exe", ".bat", ".cmd", ".sh", ".msi", ".js", ".vbs" ]
    },
    "Authentication": {
      "MaxFailedAttempts": 5,
      "LockoutDurationMinutes": 15
    },
    "RateLimiting": {
      "PermitLimit": 10,
      "WindowMinutes": 1,
      "EnableForLocalhost": false
    }
  },
  "Integrations": {
    "Primavera": {
      "Enabled": false,
      "Server": "",
      "InstanceName": "",
      "AuthenticationMode": "SQL",
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 15,
      "Companies": {
        "ALPLAPLASTICO": {
          "DatabaseName": "",
          "Enabled": true
        },
        "ALPLASOPRO": {
          "DatabaseName": "",
          "Enabled": true
        }
      }
    },
    "Innux": {
      "Enabled": false,
      "Server": "",
      "DatabaseName": "",
      "AuthenticationMode": "SQL",
      "TimeoutSeconds": 15
    },
    "AlplaProd": {
      "Enabled": false,
      "AuthenticationMode": "SQL",
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 30,
      "Plants": {
        "VIANA1": {
          "Server": "",
          "DatabaseName": "",
          "Enabled": true,
          "PipelineModel": "STANDARD"
        },
        "VIANA2": {
          "Server": "",
          "DatabaseName": "",
          "Enabled": true,
          "PipelineModel": "STANDARD"
        },
        "VIANA3": {
          "Server": "",
          "DatabaseName": "",
          "Enabled": true,
          "PipelineModel": "INHOUSE"
        }
      }
    }
  }
}