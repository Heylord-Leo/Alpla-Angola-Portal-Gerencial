<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS web.config for the Alpla Portal Gerencial frontend (React SPA).

  This file provides two essential rules:
  1. Reverse Proxy: Routes /api/* requests to the backend API on localhost:5001.
  2. SPA Fallback: All other non-file requests are rewritten to index.html
     so that client-side routing (React Router) works correctly.

  Prerequisites on the IIS server:
  - IIS URL Rewrite Module v2.1
  - IIS Application Request Routing (ARR) 3.0
  - ARR proxy feature must be enabled:
      IIS Manager > Server > Application Request Routing Cache > Server Proxy Settings > Enable proxy

  This file ships with the Vite build (placed in public/) and is deployed
  to the frontend web root automatically by the CI/CD workflow.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          Rule 0: HTTP to HTTPS redirect.
          Forces all HTTP traffic to HTTPS with a 301 Permanent Redirect.
          Required because the IIS site has both :80 and :443 bindings.
          Without this rule, the portal is accessible over plain HTTP,
          which triggers browser "Not secure" / mixed content warnings.
        -->
        <rule name="HTTPS-Redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!--
          Rule 1: Reverse Proxy for API calls.
          Forwards /api/* to the backend API site on port 5001.
          Requires ARR to be installed and proxy enabled.
          Port 5000 is NOT used (reserved by another application on AOVIA1VMS011).
        -->
        <rule name="ReverseProxy-API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:5001/api/{R:1}" />
        </rule>

        <!--
          Rule 2: SPA Fallback (React Router).
          If the request is not for an existing file or directory,
          rewrite to index.html so React Router handles the route.
        -->
        <rule name="SPA-Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <!--
    ==========================================================================
    Cache policy (version-mismatch protection).
    - index.html and build-metadata.json MUST NOT be cached, so an open tab always
      revalidates the shell and the deploy verifier reads the current build.
    - Content-hashed Vite assets (/assets/*) are immutable and cached for a year.
    These per-path <location> blocks set explicit Cache-Control headers.
    ==========================================================================
  -->
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="build-metadata.json">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="assets">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
